#!/bin/sh
# Stamp a fresh version into each tool's index.html so browsers load the new
# files right after a push. See scripts/stamp-version.mjs.
# GitHub Desktop runs hooks with a bare PATH, so look where Node usually lives.
PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"
for d in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$d" ] && PATH="$d:$PATH"; done
export PATH

if ! command -v node >/dev/null 2>&1; then
  echo "stamp-version: Node not found, committing without a new version stamp." >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 0
changed=$(node scripts/stamp-version.mjs) || { echo "stamp-version failed, committing anyway." >&2; exit 0; }
[ -n "$changed" ] && echo "$changed" | xargs git add --
exit 0
